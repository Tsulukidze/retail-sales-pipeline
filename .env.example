# Copy this file to .env and fill in the values:  cp .env.example .env
# Git ignores .env. Never commit real passwords or keys.
#
# Passwords:
# - Use at least 5 characters. Airflow hides passwords in its logs, but only
#   if they have 5 or more characters. Shorter ones stay visible, and Airflow
#   logs a warning: "Skipping masking for a secret as it's too short".
# - Passwords are used inside connection URLs, so do not use @ : / ? # %
# - A safe way to create one:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"

# --- Airflow ----------------------------------------------------------------
AIRFLOW_VERSION=3.3.2
# Linux only: set this to the output of `id -u`, so you own the files Airflow creates.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Key for encrypting passwords that Airflow saves. Create one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Secret for signing the tokens that Airflow containers use. Create one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me

# --- Airflow's own database --------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_DB_NAME=airflow

# --- Data warehouse ---------------------------------------------------------
DWH_USER=dwh
DWH_PASSWORD=change-me-dwh
DWH_DB=retail_dwh
# Port for connecting to the warehouse from your computer (DataGrip, psql, ...)
DWH_PORT=5433

# --- Kaggle API -------------------------------------------------------------
# Copy the "username" and "key" values from your kaggle.json (without quotes).
KAGGLE_USERNAME=
KAGGLE_KEY=
PIPELINE_KAGGLE_DATASET=fahadrehman07/retail-transaction-dataset
